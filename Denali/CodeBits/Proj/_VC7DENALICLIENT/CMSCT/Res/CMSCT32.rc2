//
// Version
//
#include "../cmsinclude/GBLDataVersion.h"
#include "../cmsinclude/GBLCopyright.h"   

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CAV_APP_VERSION_RCFILES
 PRODUCTVERSION CAV_APP_VERSION_RCFILES
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", CAV_COMPANYNAME
            VALUE "FileDescription", "CMSCT MFC Application"
            VALUE "FileVersion", CAV_APP_STRVERSION_RCFILES
            VALUE "InternalName", "CMSCT.exe"
            VALUE "LegalCopyright", CAV_LEGALCOPYRIGHT
            VALUE "OriginalFilename", "CMSCT.exe"
            VALUE "ProductName", CAV_PRODUCTNAME
            VALUE "ProductVersion", CAV_APP_STRVERSION_RCFILES
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END

