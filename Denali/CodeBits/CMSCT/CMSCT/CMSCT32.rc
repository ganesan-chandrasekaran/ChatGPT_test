// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON                    "Res\\Controller.ico"
IDR_CMSCT32TYPE         ICON                    "res\\CMSCT32Doc.ico"
IDI_BOOK                ICON                    "Res\\CT32x32.ico"

/////////////////////////////////////////////////////////////////////////////
//
// RT_MANIFEST
//

IDR_RT_MANIFEST         RT_MANIFEST             "Res\\CMSCT.manifest"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "IDS_FILE_GENERAL_LEDGER",     105
        MENUITEM "ID_FILE_BANKRECONCILIATION",  ID_FILE_BANKRECONCILIATION
        MENUITEM "ID_FILE_ACCOUNTSRECEIVABLE",  ID_FILE_ACCOUNTSRECEIVABLE
        MENUITEM "ID_FILE_ORDERENTRY",          ID_FILE_ORDERENTRY
        MENUITEM "ID_FILE_POINTOFSALE",         ID_FILE_POINTOFSALE
        MENUITEM "ID_FILE_INVENTORY",           ID_FILE_INVENTORY
        MENUITEM "ID_FILE_PURCHASEORDER",       ID_FILE_PURCHASEORDER
        MENUITEM "ID_FILE_ACCOUNTSPAYABLE",     ID_FILE_ACCOUNTSPAYABLE
        MENUITEM "ID_FILE_JOBCOST",             ID_FILE_JOBCOST
        MENUITEM "ID_FILE_PAYROLL",             ID_FILE_PAYROLL
        MENUITEM "ID_FILE_DATAEXCHANGE",        ID_FILE_DATAEXCHANGE
        MENUITEM SEPARATOR
        MENUITEM "ID_APP_EXIT",                 ID_APP_EXIT
    END
    POPUP "&Company"
    BEGIN
        MENUITEM "&Setup/Select Company...",    ID_COMPANY_SETUP
        MENUITEM SEPARATOR
        MENUITEM "&Install Modules...",         ID_COMPANY_INSTALLMODULES
        MENUITEM SEPARATOR
        MENUITEM "Change &Date...",             ID_COMPANY_CHANGEDATE
        MENUITEM SEPARATOR
        MENUITEM "&Fiscal Calendar...",         ID_COMPANY_FISCALCALENDAR
        MENUITEM "&Magnetic Media Constraints...", ID_COMPANY_MAGNETICMEDIACONSTRAINTS
        MENUITEM SEPARATOR
        MENUITEM "Setup Wi&zard...",            ID_COMPANY_SETUPWIZARD
    END
END


